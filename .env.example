# =============================================================================
# CodeGuard SBST — Replication Package Environment Template
# =============================================================================
# Copy this file to `.env` and fill in at least one provider's API key.
# The replication path is API-only; you do NOT need GPU access or DelftBlue.
#
#   cp .env.example .env
#
# =============================================================================

# --- LLM provider keys (pick at least one) ----------------------------------

# Anthropic Claude — RECOMMENDED for replication.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI — alternative API path.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Optional knobs ---------------------------------------------------------

# HuggingFace token — only needed if the CyberSecEval dataset becomes gated
# or if you switch to a private dataset mirror. CyberSecEval is currently public.
# HF_TOKEN=

# Semgrep ruleset — registry shorthand (e.g. `p/security-audit`) or a local
# rule directory. If unset, the experiment script's default kicks in.
# SEMGREP_RULESET=p/security-audit

# Semgrep tuning (defaults are usually fine for replication runs)
# SEMGREP_TIMEOUT_SECONDS=180
# SEMGREP_JOBS=1
